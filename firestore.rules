rules_version = '2';

// Church Chatter Firestore rules — query-safe governance + network hardening
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function churchPath(churchId) {
      return /databases/$(database)/documents/churches/$(churchId);
    }
    function memberPath(churchId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/members/$(uid);
    }
    function rolePath(churchId, roleId) {
      return /databases/$(database)/documents/churches/$(churchId)/roles/$(roleId);
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function userMembershipPath(uid, churchId) {
      return /databases/$(database)/documents/users/$(uid)/memberships/$(churchId);
    }
    function directoryPath(churchId) {
      return /databases/$(database)/documents/churchDirectory/$(churchId);
    }
    function networkProfilePath(churchId) {
      return /databases/$(database)/documents/churchNetwork/$(churchId);
    }
    function joinRequestPath(churchId, uid) {
      return /databases/$(database)/documents/churchJoinRequests/$(churchId)/requests/$(uid);
    }
    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }
    function churchInvitePath(churchId, code) {
      return /databases/$(database)/documents/churches/$(churchId)/invites/$(code);
    }

    function isCreator(churchId) {
      return signedIn()
        && exists(churchPath(churchId))
        && get(churchPath(churchId)).data.createdBy == request.auth.uid;
    }
    function creatorDeletionMode(churchId) {
      return isCreator(churchId)
        && get(churchPath(churchId)).data.deletionState == 'deleting'
        && get(churchPath(churchId)).data.deletionStartedBy == request.auth.uid;
    }
    function isMember(churchId) {
      return signedIn()
        && exists(memberPath(churchId, request.auth.uid))
        && get(memberPath(churchId, request.auth.uid)).data.status == 'active';
    }
    function hasPermission(churchId, permission) {
      return isMember(churchId)
        && get(memberPath(churchId, request.auth.uid)).data.effectivePermissions is list
        && permission in get(memberPath(churchId, request.auth.uid)).data.effectivePermissions;
    }
    function canNetwork(churchId) {
      return isCreator(churchId)
        || hasPermission(churchId, 'manageChurch')
        || hasPermission(churchId, 'communicateChurchNetwork');
    }

    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function textAtMost(value, max) {
      return value is string && value.size() <= max;
    }
    function validUrl(value) {
      return value is string && value.size() > 0 && value.size() <= 500 && value.matches('https?://.*');
    }
    function optionalUrl(value) {
      return value == '' || validUrl(value);
    }

    function knownPermissions(perms) {
      return perms is list && perms.hasOnly([
        'manageChurch', 'manageMembers', 'manageRoles', 'manageInvites',
        'moderateContent', 'createAnnouncements', 'manageEvents', 'manageGroups',
        'viewLeadershipPrayer', 'communicateChurchNetwork',
        'readCommunity', 'postChatter', 'createPrayer', 'rsvpEvents'
      ]);
    }
    function ownerPermissions(perms) {
      return knownPermissions(perms) && perms.hasAll([
        'manageChurch', 'manageMembers', 'manageRoles', 'manageInvites',
        'moderateContent', 'createAnnouncements', 'manageEvents', 'manageGroups',
        'viewLeadershipPrayer', 'communicateChurchNetwork',
        'readCommunity', 'postChatter', 'createPrayer', 'rsvpEvents'
      ]);
    }
    function memberPermissions(perms) {
      return knownPermissions(perms)
        && perms.hasOnly(['readCommunity', 'postChatter', 'createPrayer', 'rsvpEvents'])
        && perms.hasAll(['readCommunity', 'postChatter', 'createPrayer', 'rsvpEvents']);
    }
    function containsAdministrativePermissions(perms) {
      return perms is list && perms.hasAny([
        'manageChurch', 'manageMembers', 'manageRoles', 'manageInvites',
        'moderateContent', 'createAnnouncements', 'manageEvents', 'manageGroups',
        'viewLeadershipPrayer', 'communicateChurchNetwork'
      ]);
    }
    function canGrantPermissions(churchId, perms) {
      return knownPermissions(perms)
        && (!containsAdministrativePermissions(perms) || hasPermission(churchId, 'manageChurch'));
    }
    function roleExists(churchId, roleId) {
      return roleId is string && exists(rolePath(churchId, roleId));
    }
    function validRoleList(churchId, roles) {
      return roles is list && roles.size() >= 1 && roles.size() <= 4
        && roleExists(churchId, roles[0])
        && (roles.size() < 2 || roleExists(churchId, roles[1]))
        && (roles.size() < 3 || roleExists(churchId, roles[2]))
        && (roles.size() < 4 || roleExists(churchId, roles[3]));
    }
    function bootstrapChurch(churchId) {
      return signedIn()
        && existsAfter(churchPath(churchId))
        && getAfter(churchPath(churchId)).data.createdBy == request.auth.uid;
    }

    function validInviteJoin(churchId, code) {
      return signedIn()
        && code is string
        && exists(invitePath(code))
        && get(invitePath(code)).data.churchId == churchId
        && get(invitePath(code)).data.active == true
        && (get(invitePath(code)).data.expiresAt == null || get(invitePath(code)).data.expiresAt > request.time)
        && get(invitePath(code)).data.uses < get(invitePath(code)).data.maxUses
        && getAfter(invitePath(code)).data.uses == get(invitePath(code)).data.uses + 1
        && getAfter(churchInvitePath(churchId, code)).data.uses == get(invitePath(code)).data.uses + 1;
    }
    function validDiscoveryJoin(churchId) {
      return signedIn() && exists(directoryPath(churchId)) && (
        get(directoryPath(churchId)).data.joinMode == 'open'
        || (
          exists(joinRequestPath(churchId, request.auth.uid))
          && get(joinRequestPath(churchId, request.auth.uid)).data.status == 'approved'
          && getAfter(joinRequestPath(churchId, request.auth.uid)).data.status == 'joined'
        )
      );
    }

    function groupPath(churchId, groupId) {
      return /databases/$(database)/documents/churches/$(churchId)/groups/$(groupId);
    }
    function groupMemberPath(churchId, groupId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/groups/$(groupId)/members/$(uid);
    }
    function isGroupMember(churchId, groupId) {
      return isMember(churchId)
        && exists(groupMemberPath(churchId, groupId, request.auth.uid))
        && get(groupMemberPath(churchId, groupId, request.auth.uid)).data.status == 'active';
    }
    function isGroupLeader(churchId, groupId) {
      return isGroupMember(churchId, groupId)
        && get(groupMemberPath(churchId, groupId, request.auth.uid)).data.role == 'leader';
    }
    function canAccessGroup(churchId, groupId) {
      return isGroupMember(churchId, groupId) || hasPermission(churchId, 'manageGroups');
    }

    function chatterPath(churchId, postId) {
      return /databases/$(database)/documents/churches/$(churchId)/chatter/$(postId);
    }
    function chatterReactionPath(churchId, postId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/chatter/$(postId)/reactions/$(uid);
    }
    function prayerPath(churchId, collectionName, prayerId) {
      return /databases/$(database)/documents/churches/$(churchId)/$(collectionName)/$(prayerId);
    }
    function prayedPath(churchId, collectionName, prayerId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/$(collectionName)/$(prayerId)/prayedBy/$(uid);
    }
    function servePath(churchId, opportunityId) {
      return /databases/$(database)/documents/churches/$(churchId)/serveOpportunities/$(opportunityId);
    }
    function serveSignupPath(churchId, opportunityId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/serveOpportunities/$(opportunityId)/signups/$(uid);
    }
    function serveCount(data) {
      return ('signupCount' in data && data.signupCount is int) ? data.signupCount : 0;
    }

    function connectionReadable(data) {
      return signedIn()
        && data.churchAId is string
        && data.churchBId is string
        && (
          canNetwork(data.churchAId)
          || canNetwork(data.churchBId)
          || creatorDeletionMode(data.churchAId)
          || creatorDeletionMode(data.churchBId)
        );
    }
    function connectionUsable(data) {
      return connectionReadable(data)
        && data.status == 'accepted'
        && exists(networkProfilePath(data.churchAId))
        && exists(networkProfilePath(data.churchBId));
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;

      match /memberships/{churchId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && existsAfter(memberPath(churchId, uid))
          && getAfter(memberPath(churchId, uid)).data.status == 'active';
        allow update: if isSelf(uid);
        allow delete: if creatorDeletionMode(churchId)
          || (isSelf(uid) && !isCreator(churchId) && !existsAfter(memberPath(churchId, uid)))
          || (hasPermission(churchId, 'manageMembers') && uid != request.auth.uid && !existsAfter(memberPath(churchId, uid)));
      }

      match /activity/{churchId} {
        allow read, create, update: if isSelf(uid);
        allow delete: if isSelf(uid)
          || creatorDeletionMode(churchId)
          || (hasPermission(churchId, 'manageMembers') && uid != request.auth.uid);
      }
    }

    match /churches/{churchId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.name, 100)
        && request.resource.data.memberCount == 1
        && request.resource.data.status == 'active';

      allow update: if hasPermission(churchId, 'manageChurch')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','city','region','tradition','website','description','updatedAt'
        ])
        && validText(request.resource.data.name, 100)
        && textAtMost(request.resource.data.city, 80)
        && textAtMost(request.resource.data.region, 80)
        && textAtMost(request.resource.data.tradition, 80)
        && textAtMost(request.resource.data.description, 800)
        && optionalUrl(request.resource.data.website);

      allow update: if hasPermission(churchId, 'manageChurch')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'discoveryEnabled','discoveryJoinMode','networkEnabled','updatedAt'
        ])
        && (!('discoveryEnabled' in request.resource.data) || request.resource.data.discoveryEnabled is bool)
        && (!('networkEnabled' in request.resource.data) || request.resource.data.networkEnabled is bool)
        && (!('discoveryJoinMode' in request.resource.data) || request.resource.data.discoveryJoinMode in ['open','request']);

      allow update: if isCreator(churchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deletionState','deletionStartedBy','deletionStartedAt','updatedAt'
        ])
        && request.resource.data.deletionState == 'deleting'
        && request.resource.data.deletionStartedBy == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','updatedAt'])
        && resource.data.memberCount is int
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && existsAfter(memberPath(churchId, request.auth.uid))
        && getAfter(memberPath(churchId, request.auth.uid)).data.status == 'active';

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberCount','lastMemberRemovedUid','lastMemberRemovedAt','updatedAt'
        ])
        && resource.data.memberCount is int
        && resource.data.memberCount > 0
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && request.resource.data.lastMemberRemovedUid is string
        && !existsAfter(memberPath(churchId, request.resource.data.lastMemberRemovedUid))
        && (
          (request.resource.data.lastMemberRemovedUid == request.auth.uid && !isCreator(churchId))
          || (request.resource.data.lastMemberRemovedUid != request.auth.uid && hasPermission(churchId, 'manageMembers'))
        );

      allow delete: if creatorDeletionMode(churchId);

      match /members/{uid} {
        allow get: if isMember(churchId) || isSelf(uid) || creatorDeletionMode(churchId);
        allow list: if isMember(churchId) || creatorDeletionMode(churchId);

        allow create: if isSelf(uid) && (
          (
            bootstrapChurch(churchId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.roleIds is list
            && request.resource.data.roleIds.hasOnly(['owner'])
            && request.resource.data.roleIds.size() == 1
            && ownerPermissions(request.resource.data.effectivePermissions)
          ) || (
            request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.roleIds is list
            && request.resource.data.roleIds.hasOnly(['member'])
            && request.resource.data.roleIds.size() == 1
            && memberPermissions(request.resource.data.effectivePermissions)
            && validInviteJoin(churchId, request.resource.data.joinedViaInvite)
          ) || (
            request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.roleIds is list
            && request.resource.data.roleIds.hasOnly(['member'])
            && request.resource.data.roleIds.size() == 1
            && memberPermissions(request.resource.data.effectivePermissions)
            && request.resource.data.joinedViaDiscovery == true
            && request.resource.data.discoveryJoinMode in ['open','request']
            && validDiscoveryJoin(churchId)
          )
        );

        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL'])
          && validText(request.resource.data.displayName, 80)
          && textAtMost(request.resource.data.photoURL, 500);

        allow update: if hasPermission(churchId, 'manageRoles')
          && !('owner' in resource.data.roleIds)
          && !('owner' in request.resource.data.roleIds)
          && validRoleList(churchId, request.resource.data.roleIds)
          && canGrantPermissions(churchId, request.resource.data.effectivePermissions)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'roleIds','effectivePermissions','rolesUpdatedAt'
          ]);

        allow delete: if creatorDeletionMode(churchId)
          || (isSelf(uid) && !isCreator(churchId))
          || (hasPermission(churchId, 'manageMembers') && uid != request.auth.uid && !isCreator(churchId));
      }

      match /roles/{roleId} {
        allow read: if isMember(churchId) || creatorDeletionMode(churchId);

        allow create: if (
          bootstrapChurch(churchId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.system == true
          && validText(request.resource.data.name, 60)
          && (
            (roleId == 'owner' && ownerPermissions(request.resource.data.permissions))
            || (roleId == 'member' && memberPermissions(request.resource.data.permissions))
          )
        ) || (
          hasPermission(churchId, 'manageRoles')
          && roleId != 'owner'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.system == false
          && validText(request.resource.data.name, 60)
          && canGrantPermissions(churchId, request.resource.data.permissions)
        );

        allow update: if roleId == 'member'
          && hasPermission(churchId, 'manageRoles')
          && request.resource.data.permissions == resource.data.permissions
          && request.resource.data.system == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','updatedAt']);

        allow update: if !(roleId in ['owner','member'])
          && hasPermission(churchId, 'manageRoles')
          && request.resource.data.system == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','permissions','updatedAt'])
          && validText(request.resource.data.name, 60)
          && canGrantPermissions(churchId, request.resource.data.permissions);

        allow delete: if creatorDeletionMode(churchId)
          || (
            hasPermission(churchId, 'manageRoles')
            && !(roleId in ['owner','member'])
            && resource.data.system == false
            && (!containsAdministrativePermissions(resource.data.permissions) || hasPermission(churchId, 'manageChurch'))
          );
      }

      match /invites/{code} {
        allow read: if hasPermission(churchId, 'manageInvites') || creatorDeletionMode(churchId);
        allow create: if hasPermission(churchId, 'manageInvites')
          && request.resource.data.code == code
          && request.resource.data.churchId == churchId
          && request.resource.data.active == true
          && request.resource.data.uses == 0
          && request.resource.data.maxUses is int
          && request.resource.data.maxUses >= 1
          && request.resource.data.maxUses <= 500
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if hasPermission(churchId, 'manageInvites')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
        allow update: if signedIn()
          && resource.data.active == true
          && resource.data.uses < resource.data.maxUses
          && (resource.data.expiresAt == null || resource.data.expiresAt > request.time)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses','lastUsedAt'])
          && request.resource.data.uses == resource.data.uses + 1
          && existsAfter(memberPath(churchId, request.auth.uid));
        allow delete: if hasPermission(churchId, 'manageInvites') || creatorDeletionMode(churchId);
      }

      match /rooms/{roomId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageGroups') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageGroups');
      }

      match /chatter/{postId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'moderateContent') || creatorDeletionMode(churchId);
        allow create: if hasPermission(churchId, 'postChatter')
          && request.resource.data.authorUid == request.auth.uid
          && validText(request.resource.data.body, 4000);
        allow update: if (resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','editedAt']))
          || (hasPermission(churchId, 'moderateContent')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned','moderatedAt']))
          || (isMember(churchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']));
        allow delete: if creatorDeletionMode(churchId)
          || resource.data.authorUid == request.auth.uid
          || hasPermission(churchId, 'moderateContent');

        match /comments/{commentId} {
          allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'moderateContent') || creatorDeletionMode(churchId);
          allow create: if hasPermission(churchId, 'postChatter')
            && request.resource.data.authorUid == request.auth.uid
            && validText(request.resource.data.body, 1500);
          allow update: if resource.data.authorUid == request.auth.uid;
          allow delete: if creatorDeletionMode(churchId)
            || resource.data.authorUid == request.auth.uid
            || hasPermission(churchId, 'moderateContent');
        }

        match /reactions/{uid} {
          allow get: if isSelf(uid) && hasPermission(churchId, 'readCommunity');
          allow list: if creatorDeletionMode(churchId);
          allow create, delete: if isSelf(uid) && hasPermission(churchId, 'readCommunity');
          allow update: if false;
        }
      }

      match /prayers/{prayerId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'moderateContent') || creatorDeletionMode(churchId);
        allow create: if hasPermission(churchId, 'createPrayer')
          && validText(request.resource.data.body, 2500)
          && request.resource.data.status == 'open';
        allow update: if hasPermission(churchId, 'moderateContent')
          || (!resource.data.anonymous && resource.data.authorUid == request.auth.uid)
          || (isMember(churchId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedCount']));
        allow delete: if creatorDeletionMode(churchId)
          || hasPermission(churchId, 'moderateContent')
          || (!resource.data.anonymous && resource.data.authorUid == request.auth.uid);

        match /prayedBy/{uid} {
          allow get: if isSelf(uid) && hasPermission(churchId, 'readCommunity');
          allow list: if creatorDeletionMode(churchId);
          allow create, delete: if isSelf(uid) && hasPermission(churchId, 'readCommunity');
          allow update: if false;
        }
      }

      match /leadershipPrayers/{prayerId} {
        allow read: if hasPermission(churchId, 'viewLeadershipPrayer') || creatorDeletionMode(churchId);
        allow create: if hasPermission(churchId, 'createPrayer')
          && validText(request.resource.data.body, 2500)
          && request.resource.data.status == 'open';
        allow update: if hasPermission(churchId, 'viewLeadershipPrayer');
        allow delete: if creatorDeletionMode(churchId)
          || hasPermission(churchId, 'moderateContent')
          || (!resource.data.anonymous && resource.data.authorUid == request.auth.uid);

        match /prayedBy/{uid} {
          allow get: if isSelf(uid) && hasPermission(churchId, 'viewLeadershipPrayer');
          allow list: if creatorDeletionMode(churchId);
          allow create, delete: if isSelf(uid) && hasPermission(churchId, 'viewLeadershipPrayer');
          allow update: if false;
        }
      }

      match /announcements/{announcementId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'createAnnouncements') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'createAnnouncements');
      }

      match /events/{eventId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageEvents') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageEvents');

        match /rsvps/{uid} {
          allow get: if isSelf(uid) || hasPermission(churchId, 'manageEvents') || hasPermission(churchId, 'manageMembers');
          allow list: if hasPermission(churchId, 'manageEvents') || creatorDeletionMode(churchId);
          allow create, update: if isSelf(uid) && hasPermission(churchId, 'rsvpEvents');
          allow delete: if creatorDeletionMode(churchId)
            || isSelf(uid)
            || hasPermission(churchId, 'manageEvents')
            || hasPermission(churchId, 'manageMembers');
        }
      }

      match /groups/{groupId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageGroups') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageGroups');

        match /members/{uid} {
          allow get: if creatorDeletionMode(churchId)
            || (isMember(churchId) && (isSelf(uid) || canAccessGroup(churchId, groupId)));
          allow list: if canAccessGroup(churchId, groupId) || creatorDeletionMode(churchId);
          allow create: if hasPermission(churchId, 'manageGroups')
            || (isSelf(uid) && isMember(churchId) && get(groupPath(churchId, groupId)).data.joinMode == 'open');
          allow update: if hasPermission(churchId, 'manageGroups');
          allow delete: if creatorDeletionMode(churchId)
            || hasPermission(churchId, 'manageGroups')
            || hasPermission(churchId, 'manageMembers')
            || isSelf(uid);
        }

        match /chatter/{postId} {
          allow read: if canAccessGroup(churchId, groupId) || creatorDeletionMode(churchId);
          allow create: if canAccessGroup(churchId, groupId) && request.resource.data.authorUid == request.auth.uid;
          allow update: if resource.data.authorUid == request.auth.uid;
          allow delete: if creatorDeletionMode(churchId)
            || resource.data.authorUid == request.auth.uid
            || isGroupLeader(churchId, groupId)
            || hasPermission(churchId, 'moderateContent');
        }

        match /prayers/{prayerId} {
          allow read: if canAccessGroup(churchId, groupId) || creatorDeletionMode(churchId);
          allow create: if canAccessGroup(churchId, groupId) && validText(request.resource.data.body, 2500);
          allow update, delete: if creatorDeletionMode(churchId)
            || isGroupLeader(churchId, groupId)
            || hasPermission(churchId, 'moderateContent')
            || (!resource.data.anonymous && resource.data.authorUid == request.auth.uid);
        }

        match /events/{eventId} {
          allow read: if canAccessGroup(churchId, groupId) || creatorDeletionMode(churchId);
          allow create, update, delete: if creatorDeletionMode(churchId)
            || isGroupLeader(churchId, groupId)
            || hasPermission(churchId, 'manageGroups');
        }
      }

      match /resources/{resourceId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageChurch') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageChurch');
      }

      match /serveOpportunities/{opportunityId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageGroups') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageGroups');

        match /signups/{uid} {
          allow get: if isSelf(uid) || hasPermission(churchId, 'manageGroups') || hasPermission(churchId, 'manageMembers');
          allow list: if hasPermission(churchId, 'manageGroups') || creatorDeletionMode(churchId);
          allow create: if isSelf(uid) && hasPermission(churchId, 'readCommunity');
          allow delete: if creatorDeletionMode(churchId)
            || isSelf(uid)
            || hasPermission(churchId, 'manageGroups')
            || hasPermission(churchId, 'manageMembers');
          allow update: if false;
        }
      }

      match /settings/{settingId} {
        allow read: if hasPermission(churchId, 'readCommunity') || hasPermission(churchId, 'manageChurch') || creatorDeletionMode(churchId);
        allow create, update, delete: if hasPermission(churchId, 'manageChurch');
      }

      match /reports/{reportId} {
        allow create: if isMember(churchId) && request.resource.data.reporterUid == request.auth.uid;
        allow read, update: if hasPermission(churchId, 'moderateContent') || creatorDeletionMode(churchId);
        allow delete: if creatorDeletionMode(churchId);
      }

      // Any future congregation-scoped subcollection is removable only during an explicit
      // creator-owned deletion. This makes deletion forward-compatible without granting
      // ordinary broad write access.
      match /{document=**} {
        allow read, delete: if creatorDeletionMode(churchId);
      }
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.churchId is string
        && request.resource.data.active == true
        && request.resource.data.uses == 0
        && request.resource.data.maxUses is int
        && hasPermission(request.resource.data.churchId, 'manageInvites');
      allow update: if hasPermission(resource.data.churchId, 'manageInvites')
        || (
          signedIn()
          && resource.data.active == true
          && resource.data.uses < resource.data.maxUses
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses','lastUsedAt'])
          && request.resource.data.uses == resource.data.uses + 1
        );
      allow delete: if hasPermission(resource.data.churchId, 'manageInvites')
        || creatorDeletionMode(resource.data.churchId);
    }

    match /churchDirectory/{churchId} {
      // Discovery is opt-in because only enabled congregations have a document here.
      allow read: if signedIn();
      allow create, update: if hasPermission(churchId, 'manageChurch')
        && request.resource.data.churchId == churchId
        && validText(request.resource.data.name, 100)
        && request.resource.data.joinMode in ['open','request'];
      allow delete: if hasPermission(churchId, 'manageChurch') || creatorDeletionMode(churchId);
    }

    match /churchNetwork/{churchId} {
      // This collection contains only the opt-in public church profile mirror. Reading it is
      // safe for authenticated Church Chatter users; acting on behalf of a church is still
      // separately permission-gated below.
      allow read: if signedIn();
      allow create, update: if hasPermission(churchId, 'manageChurch')
        && request.resource.data.churchId == churchId
        && validText(request.resource.data.name, 100);
      allow delete: if hasPermission(churchId, 'manageChurch') || creatorDeletionMode(churchId);
    }

    match /churchJoinRequests/{churchId}/requests/{uid} {
      allow get: if isSelf(uid)
        || hasPermission(churchId, 'manageMembers')
        || hasPermission(churchId, 'manageChurch')
        || creatorDeletionMode(churchId);
      allow list: if hasPermission(churchId, 'manageMembers')
        || hasPermission(churchId, 'manageChurch')
        || creatorDeletionMode(churchId);
      allow create: if isSelf(uid)
        && exists(directoryPath(churchId))
        && get(directoryPath(churchId)).data.joinMode == 'request'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.churchId == churchId
        && request.resource.data.status == 'pending';
      allow update: if (
          isSelf(uid)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.churchId == churchId
          && (
            (resource.data.status == 'denied' && request.resource.data.status == 'pending')
            || (resource.data.status == 'approved' && request.resource.data.status == 'joined')
          )
        ) || (
          (hasPermission(churchId, 'manageMembers') || hasPermission(churchId, 'manageChurch'))
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved','denied']
          && request.resource.data.reviewedBy == request.auth.uid
        );
      allow delete: if creatorDeletionMode(churchId)
        || (isSelf(uid) && !isCreator(churchId))
        || (hasPermission(churchId, 'manageMembers') && uid != request.auth.uid);
    }

    match /churchConnections/{connectionId} {
      // Clients query churchAId and churchBId separately. Those equality queries are directly
      // provable by Firestore Security Rules, unlike the old array-contains participant query.
      allow get, list: if connectionReadable(resource.data);

      allow create: if signedIn()
        && request.resource.data.connectionId == connectionId
        && request.resource.data.churchAId is string
        && request.resource.data.churchBId is string
        && request.resource.data.churchIds is list
        && request.resource.data.churchIds.size() == 2
        && request.resource.data.requestedByChurchId in request.resource.data.churchIds
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && canNetwork(request.resource.data.requestedByChurchId)
        && exists(networkProfilePath(request.resource.data.churchAId))
        && exists(networkProfilePath(request.resource.data.churchBId));

      allow update: if (
          resource.data.status == 'pending'
          && request.resource.data.status in ['accepted','declined']
          && request.resource.data.respondedByChurchId in resource.data.churchIds
          && request.resource.data.respondedByChurchId != resource.data.requestedByChurchId
          && request.resource.data.respondedByUid == request.auth.uid
          && canNetwork(request.resource.data.respondedByChurchId)
        ) || (
          connectionUsable(resource.data)
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        );

      allow delete: if connectionReadable(resource.data);

      match /messages/{messageId} {
        allow read: if connectionUsable(get(/databases/$(database)/documents/churchConnections/$(connectionId)).data)
          || creatorDeletionMode(get(/databases/$(database)/documents/churchConnections/$(connectionId)).data.churchAId)
          || creatorDeletionMode(get(/databases/$(database)/documents/churchConnections/$(connectionId)).data.churchBId);
        allow create: if connectionUsable(get(/databases/$(database)/documents/churchConnections/$(connectionId)).data)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderChurchId in get(/databases/$(database)/documents/churchConnections/$(connectionId)).data.churchIds
          && canNetwork(request.resource.data.senderChurchId)
          && validText(request.resource.data.body, 3000);
        allow update: if false;
        allow delete: if connectionReadable(get(/databases/$(database)/documents/churchConnections/$(connectionId)).data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
